        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{targetLang}を目標言語のプレースホルダーとして使用します。小説翻訳プロンプトは、段落単位の翻訳と一括翻訳で有効です。"
          }
        },
        "zh-Hant" : {
