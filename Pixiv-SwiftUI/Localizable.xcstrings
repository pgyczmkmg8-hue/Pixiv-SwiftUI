        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "段落数または文字数の上限に達するとバッチを分割します。バッチ間の文脈により、モデルは人名や語調を一貫して保てます。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
